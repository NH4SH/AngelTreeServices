# REVIEW ONLY. Not imported, mounted, loaded or deployed.
# Append only after shared-ingress review. Preserve existing global options and
# both scanner site blocks. This candidate deliberately cannot accept orders.
# The existing router TCP 443 -> ingress 9443 mapping is unchanged.
https://checkout.angeltreeservices.org:9443 {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	header {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	}
	respond "Online firewood ordering is not available. Call (540) 388-8715 or visit https://angeltreeservices.org/firewood/ for phone ordering." 503
}
