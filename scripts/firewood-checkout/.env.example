# Copy to a private, Git-ignored .env.firewood-crm.local (mode 600).
# Every credential below must belong to an isolated test environment.
FIREWOOD_CRM_TEST_ENABLED=0
FIREWOOD_CRM_TEST_ORIGIN=http://127.0.0.1:3198
FIREWOOD_TEST_IMPORT_SOURCE_ID=website_local_test
FIREWOOD_TEST_STRIPE_ACCOUNT_ID=
FIREWOOD_TEST_IMPORT_KEY_ID=
FIREWOOD_TEST_IMPORT_SHARED_SECRET=
FIREWOOD_STRIPE_TEST_SECRET_KEY=
FIREWOOD_STRIPE_TEST_WEBHOOK_SECRET=

# Optional hosted-test storage. Disabled by default. Never use with CRM enabled.
FIREWOOD_HOSTED_TEST_STORAGE=0
FIREWOOD_TEST_STORAGE_ORIGIN=https://angel-firewood-test.netlify.app
FIREWOOD_TEST_STORAGE_TOKEN=
FIREWOOD_TEST_DATABASE_URL=
FIREWOOD_TEST_DATABASE_HOST=

# On the separate test service only; never set on the public site or CRM.
FIREWOOD_HOSTED_TEST_ENABLED=0
FIREWOOD_STRIPE_TEST_ACCOUNT_ID=acct_1UU9U8RAZXGe6tX0
FIREWOOD_TEST_EMAIL_ENABLED=0
FIREWOOD_TEST_EMAIL_FROM=
FIREWOOD_TEST_RESEND_KEY=
